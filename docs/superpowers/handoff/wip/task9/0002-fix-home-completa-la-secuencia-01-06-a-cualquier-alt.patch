+/**
+ * scrollY que deja en el borde inferior del viewport el punto de `locator` a
+ * `fraction` de su alto (1: su borde inferior; 0,5: su mitad; 0: su borde superior).
+ */
+function bottomAtViewportBottom(locator: Locator, fraction = 1): Promise<number> {
+  return locator.evaluate((element, f) => {
+    const rect = element.getBoundingClientRect()
+    return window.scrollY + rect.top + rect.height * f - window.innerHeight
+  }, fraction)
+}
