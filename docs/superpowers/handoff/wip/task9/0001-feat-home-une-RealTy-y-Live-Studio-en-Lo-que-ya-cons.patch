+/** Escala horizontal calculada de un elemento (1 si no tiene transformación). */
+function scaleOf(locator: Locator): Promise<number> {
+  return locator.evaluate((element) => new DOMMatrixReadOnly(getComputedStyle(element).transform).a)
+}
+
+/**
+ * Borde superior del elemento en el documento, SIN su transformación: la escala
+ * de la tarjeta de RealTy desplaza su getBoundingClientRect, pero no la caja con
+ * la que motion calcula el avance del scroll (offsetTop).
+ */
+function layoutTop(locator: Locator): Promise<number> {
+  return locator.evaluate((element) => {
+    let top = 0
+    for (let node = element as HTMLElement | null; node; node = node.offsetParent as HTMLElement | null) {
+      top += node.offsetTop
+    }
+    return top
+  })
