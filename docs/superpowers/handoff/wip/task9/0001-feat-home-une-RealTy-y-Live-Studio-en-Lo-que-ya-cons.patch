+}
+
+// La consola de RealTy está pensada para ≥ 272 px de ancho (su portada en
+// /realty). Dentro de la tarjeta, a 320 px, las fichas se estrechan: ninguna
+// etiqueta ni sparkline puede salirse de su ficha e invadir la vecina.
+test.describe('T9 · Lo que ya construimos · 320 px', () => {
+  test.use({ viewport: { width: 320, height: 568 } })
+
+  for (const locale of ['es', 'en'] as const) {
+    test(`${locale}: nada de la consola de RealTy se sale de su ficha`, async ({ page }) => {
+      await page.goto(`/${locale}`)
+      const dict = locale === 'es' ? es : en
+      const card = page.locator(`#${dict.built.sectionId} [data-built-card="realty"]`)
+      // Cada ficha (StatTile) es el padre de su sparkline (svg role="img").
+      const overflow = await card.evaluate((element) =>
+        Array.from(element.querySelectorAll('svg[role="img"]')).flatMap((sparkline) => {
+          const tile = sparkline.parentElement!
+          const box = tile.getBoundingClientRect()
+          return Array.from(tile.children)
+            .filter((child) => {
+              const rect = child.getBoundingClientRect()
+              const range = document.createRange()
+              range.selectNodeContents(child)
+              const text = range.getBoundingClientRect()
+              return Math.max(rect.right, text.right) > box.right + 0.5
+            })
+            .map((child) => `${tile.firstElementChild?.textContent}: ${child.textContent || child.tagName}`)
+        })
+      )
+      expect(overflow, 'contenido que se sale de su ficha').toEqual([])
+    })
+  }
