+      )
+      expect(ratio, `línea del paso ${i + 1} trazada entera`).toBeGreaterThan(0.99)
+    }
+
+    const card = section.locator('[data-built-card="realty"]')
+    expect(await card.evaluate((el) => getComputedStyle(el).transform)).toMatch(IDENTITY_TRANSFORM)
+    await card.scrollIntoViewIfNeeded()
+    expect(await countVisibleBlue(page)).toBe(0)
+  })
+})
+
+test.describe('T9 · ConsoleFrame compartido', () => {
+  test('/es/realty conserva la consola completa de su portada, con el embudo', async ({ page }) => {
+    await page.goto('/es/realty')
+    const hero = page.locator('section[data-header-start="dark"]')
+    await expect(hero).toContainText(es.realty.hero.console.label)
+    await expect(hero).toContainText(es.realty.hero.console.funnel.label)
+    await expect(hero.getByRole('img', { name: es.realty.hero.console.funnel.label })).toHaveCount(1)
+    for (const stage of es.realty.hero.console.funnel.stages) {
+      await expect(hero).toContainText(stage.name)
+    }
+    const text = (await hero.innerText()).toLowerCase()
+    expect(text.split(es.realty.demoLabel.toLowerCase()).length - 1, 'demoLabel una sola vez en el marco').toBe(1)
+  })
+
+  test('ningún script de /es lleva la consola de RealTy: se pinta en el servidor (plan §3.8)', async ({ request }) => {
+    const html = await (await request.get('/es')).text()
+    const sources = [...html.matchAll(/<script\b[^>]*\bsrc="([^"]+)"/g)]
+      .map(([, src]) => src.replace(/&amp;/g, '&'))
+      .filter((src) => src.startsWith('/_next/'))
+    expect(sources.length, 'scripts de /es').toBeGreaterThan(0)
+    for (const src of sources) {
+      const response = await request.get(src)
+      expect(response.status(), src).toBe(200)
+      const body = await response.text()
+      const found = REALTY_CLIENT_MARKERS.filter((marker) => body.includes(marker))
+      expect(found, `${src} lleva código de la consola de RealTy`).toEqual([])
+    }
+  })
+})
