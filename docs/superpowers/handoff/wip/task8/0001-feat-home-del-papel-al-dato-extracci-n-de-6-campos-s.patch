+// Ancho del marco 3:2 de FocalCover: max(ancho del marco, 1,5 × su alto). En md
+// el marco mide min(78svh, 48rem) de alto, así que la imagen nunca pasa de
+// 1,5 × 48rem = 1152 px; en celular (aspect-[4/5] a todo el ancho) mide
+// 1,5 × 1,25 = 1,875 × el ancho del marco, ≈ 170vw con los márgenes. En rem,
+// como la variante md: (plan §3.6).
+const IMAGE_SIZES = "(min-width: 48rem) 1152px, 170vw"
+
+/**
+ * "Del papel al dato" — `#gobierno` / `#government` (diseño §5.4). Sección de
+ * servidor: renderiza el expediente y lo pasa a la isla como `media`, con la
+ * vista previa de coverPlaceholder (nunca placeholder="blur": ver
+ * src/lib/image-placeholder.ts). Así next/image y la miniatura del import
+ * estático no entran en el JS de la isla (presupuesto de JS, acción 5).
+ * Carga diferida por defecto: la sección está bajo el pliegue.
+ */
+export function Dossier({ content, locale }: { content: DossierContent; locale: Locale }) {
+  return (
+    <DossierStage
+      content={content}
+      locale={locale}
+      media={
+        <Image
+          src={expediente}
+          alt={content.imageAlt}
+          fill
+          placeholder={coverPlaceholder(expediente)}
+          sizes={IMAGE_SIZES}
+          className="object-cover"
+        />
+      }
+    />
+  )
+}
diff --git a/src/components/sections/home/DossierStage.tsx b/src/components/sections/home/DossierStage.tsx
