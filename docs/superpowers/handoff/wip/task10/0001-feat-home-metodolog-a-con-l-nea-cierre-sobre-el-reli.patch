+++ b/src/components/sections/CTAMedia.tsx
@@ -0,0 +1,51 @@
+import Image from "next/image"
+import relieve from "@/assets/images/relieve.jpg"
+import { coverPlaceholder } from "@/lib/image-placeholder"
+
+// Ancho del marco 3:2 de FocalCover en el cierre: la capa mide el ancho de la
+// sección (100vw) y 1,7 × su alto H (sobresale 50 % arriba y 20 % abajo), así
+// que el marco mide max(100vw, 1,5 × 1,7 × H) = max(100vw, 2,55 × H). H depende
+// del texto, pero en rem es casi constante por tramo (medido en es y en):
+// - desde md (48rem): 43,46rem en todos los anchos (h2 en dos líneas) → 111rem;
+//   max(100vw, 111rem) sin max(): 100vw desde 111rem de ancho y 111rem por debajo;
+// - sm (40–48rem): 39,76rem → 102rem;
+// - por debajo de sm: 25,7–33,3rem según las líneas del h2 y del párrafo; la
+//   cota es la del más estrecho (320 px, 33,27rem) → 85rem.
+// En escritorio apaisado (≥ 3:2, desde ~1200 px de ancho) el navegador elige la
+// misma variante que para la portada (1920 o 3840 px) y reutiliza su descarga;
+// con «140vw» pedía otra de 2048 px a 1440×900, y entre 768 y 1024 px de ancho
+// se quedaba en el 60–80 % del marco. Si cambia el copy del cierre, lo vigila la
+// prueba «el sizes cubre el marco sin pedir de más» (e2e).
+const CLOSING_SIZES = [
+  "(min-width: 111rem) 100vw",
+  "(min-width: 48rem) 111rem",
+  "(min-width: 40rem) 102rem",
+  "85rem",
+].join(", ")
+
+/**
+ * Relieve del cierre (diseño §5.9), renderizado en el servidor y pasado a CTA
+ * como slot (`media`): así ni `next/image` ni la vista previa del import
+ * estático viajan en el JavaScript de la isla (plan §3.8). Sin directiva y sin
+ * hooks: no lo importes desde un módulo "use client", o la imagen volvería al JS
+ * del cliente. Carga perezosa (la de `next/image` por defecto): está al final de
+ * la página. Vista previa con `coverPlaceholder`, nunca `placeholder="blur"`
+ * (decisión 12 de T6). Decorativa (`alt=""`): el título y el texto del cierre
+ * llevan el contenido.
+ *
+ * Contraste: el degradado de CTA (#0a0a0a sólido arriba y abajo, 80 % en el
+ * centro) deja pasar como mucho el 20 % de la imagen. Peor píxel de la zona que
+ * asoma: 200/255 → 0,2 × 200 + 0,8 × 10 ≈ 48, y #a3a3a3 queda en ≈ 5,2:1.
+ */
+export function CTAMedia() {
+  return (
+    <Image
+      src={relieve}
+      alt=""
+      fill
+      sizes={CLOSING_SIZES}
+      placeholder={coverPlaceholder(relieve)}
+      className="object-cover"
+    />
+  )
+}
