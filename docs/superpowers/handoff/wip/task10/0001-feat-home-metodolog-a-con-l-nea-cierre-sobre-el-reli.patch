diff --git a/src/components/sections/home/MethodologyLine.tsx b/src/components/sections/home/MethodologyLine.tsx
new file mode 100644
index 0000000..f0e323e
--- /dev/null
+++ b/src/components/sections/home/MethodologyLine.tsx
@@ -0,0 +1,156 @@
+"use client"
+
+import { useEffect, useRef, useState } from "react"
+import { animateSingleValue, m, useInView, useMotionValue, useMotionValueEvent } from "motion/react"
+import { InstrumentLabel } from "@/components/ui/InstrumentLabel"
+import { useStageProgress } from "@/hooks/useStageProgress"
+import type { StageOffset } from "@/hooks/useStageProgress"
+import { easing } from "@/lib/motion"
+
+interface MethodologyStep {
+  num: string
+  title: string
+  desc: string
+}
+
+interface MethodologyContent {
+  sectionId: string
+  title: string
+  phaseLabel: string
+  description: string
+  steps: readonly MethodologyStep[]
+}
+
+/** 0 cuando la fila de fases asoma al 80 % del viewport; 1 cuando su borde superior llega al 30 %. */
+const OFFSET: StageOffset = ["start 0.8", "start 0.3"]
+/** Cuánto debe pasar la línea más allá del nodo de una fase para activarla (fracción del trazo). */
+const REACH = 0.04
+/** Modo inView (celular): la línea se traza una vez, en 1,6 s, al entrar en pantalla. */
+const INVIEW_DURATION = 1.6
+
+/** Fases alcanzadas por una línea trazada hasta `line` (0→1): el nodo de la fase i está en i / total. */
+function phasesReached(line: number, total: number) {
+  let count = 0
+  for (let i = 0; i < total; i += 1) {
+    if (line >= i / total + REACH) count = i + 1
+  }
+  return count
+}
+
+/**
+ * Metodología (diseño §5.6): una línea de 1 px se traza de izquierda a derecha
+ * al bajar, y cada fase pasa de gris (#737373, AA sobre blanco) a negro cuando
+ * la línea la alcanza.
+ *
+ * - scrub (≥ 48rem × 37,5rem): la línea horizontal (scaleX, origen a la
+ *   izquierda) sigue al scroll mientras la fila de fases sube del 80 % al 30 %
+ *   del viewport. Sin sticky: el propio desplazamiento de la fila es el recorrido.
+ * - inView (celular, celular apaisado): la línea se traza una sola vez al entrar
+ *   en pantalla. Por debajo de md es vertical (scaleY, origen arriba).
+ * - static (reducir movimiento): línea completa y las 5 fases activas.
+ *
+ * Solo se anima `transform`; el color de fases, puntos y textos es un cambio de
+ * estado discreto, sin transición. Hidratación: `line` empieza en 0 y el modo en
+ * "scrub" para todos, así que el HTML del servidor y el primer render coinciden
+ * (fases inactivas, línea sin trazar). Sin JavaScript, globals.css
+ * (`@media (scripting: none)`) pinta el estado final, como en la portada y en
+ * Tesis y Capacidades.
+ */
+export function MethodologyLine({ content }: { content: MethodologyContent }) {
+  const trackRef = useRef<HTMLDivElement>(null)
+  const { progress, mode } = useStageProgress(trackRef, OFFSET)
+  const inView = useInView(trackRef, { once: true, amount: 0.3 })
+  const line = useMotionValue(0)
+  const total = content.steps.length
+  const [reached, setReached] = useState(0)
+
+  useMotionValueEvent(line, "change", (value) => setReached(phasesReached(value, total)))
+
+  useEffect(() => {
+    if (mode === "static") {
+      line.set(1)
+      return
+    }
+    if (mode === "scrub") {
+      line.set(progress.get())
+      return progress.on("change", (value) => line.set(value))
+    }
+    if (!inView) {
+      line.set(0)
+      return
+    }
+    // animateSingleValue en lugar de animate() (plan §3.8); stop() en el propio
+    // valor: con animaciones instantáneas animateSingleValue no devuelve controles.
+    animateSingleValue(line, 1, { duration: INVIEW_DURATION, ease: easing.entrance })
+    return () => line.stop()
+  }, [mode, inView, progress, line])
+
+  const active = mode === "static" ? total : reached
+
+  return (
+    <section
+      id={content.sectionId}
+      data-header-theme="light"
+      data-stage-mode={mode}
+      className="relative border-t border-[#e5e5e5] bg-white py-16 sm:py-32"
+    >
+      <div className="mx-auto max-w-7xl px-6">
+        <div className="mb-12 max-w-3xl sm:mb-20">
+          <h2 className="mb-8 font-heading text-3xl font-bold tracking-tight text-[#0a0a0a] sm:text-5xl md:text-7xl">
+            {content.title}
+          </h2>
+          <p className="text-lg leading-relaxed text-[#525252] md:text-xl">{content.description}</p>
