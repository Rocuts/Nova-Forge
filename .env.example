# Copy to .env.local and fill in. Never commit real values.

# --- Diagnóstico (chat de la wizard) ---
# Clave de OpenAI; si falta, la ruta devuelve un informe de respaldo.
OPENAI_API_KEY=

# --- Demo de voz de RealTy (servidor; ninguna NEXT_PUBLIC) ---
# "true" activa la demo (UI de la landing + ruta /api/realty/voice-session).
REALTY_VOICE_DEMO_ENABLED=false
# Modo "public" (sin esta clave): el agente es publico en ElevenLabs y se protege alli con su allowlist de dominios; la ruta devuelve el agent id.
# Modo "signed" (con esta clave): el agente es privado y la ruta devuelve una URL firmada por sesion; la clave nunca sale del servidor.
ELEVENLABS_API_KEY=
# Id del agente de ElevenLabs (formato agent_...). Obligatorio en los dos modos.
ELEVENLABS_AGENT_ID=
# Duración máxima por sesión en segundos (rango 60-600, por defecto 120).
REALTY_VOICE_DEMO_MAX_SECONDS=120
# Presupuesto global de minutos por día UTC (por defecto 15).
REALTY_VOICE_DEMO_DAILY_MINUTES=15
# Sesiones por navegador y día, tope suave por cookie (por defecto 3).
REALTY_VOICE_DEMO_PER_BROWSER=3
# Sesiones por IP (hasheada) y día (por defecto 4).
REALTY_VOICE_DEMO_PER_IP=4

# --- Redis del contador de cupo (Upstash / Vercel KV; se acepta cualquiera de los dos prefijos) ---
# Sin estas variables el cupo cae a un contador en memoria por instancia (solo dev).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
